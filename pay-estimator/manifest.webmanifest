{
  "id": "./",
  "name": "Rota to Payslip",
  "short_name": "Rota Pay",
  "description": "Enter your shifts and see what lands in your account on payday.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#E9ECF3",
  "theme_color": "#1D2A56",
  "lang": "en-GB",
  "dir": "ltr",
  "categories": ["productivity", "finance", "business"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "./shot-rota.png", "sizes": "414x896", "type": "image/png", "form_factor": "narrow",
      "label": "Tap the days you are working" },
    { "src": "./shot-pay.png", "sizes": "414x896", "type": "image/png", "form_factor": "narrow",
      "label": "Your estimate, laid out like a payslip" }
  ],
  "shortcuts": [
    { "name": "Add today's shift", "short_name": "Add shift", "url": "./?go=today",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] },
    { "name": "Pay breakdown", "short_name": "Breakdown", "url": "./?go=slip",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] }
  ]
}
